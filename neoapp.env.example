# Web Service: beanboard-api
PORT=3000
NODE_ENV=production
DATABASE_AUTO_MIGRATE=true
NATS_STREAM=BEANBOARD_ORDERS
NATS_SUBJECT=beanboard.orders
NATS_CONSUMER=beanboard-baristas
NATS_MANAGE_RESOURCES=false
S3_REGION=us-east-1
S3_BUCKET=beanboard-receipts
S3_FORCE_PATH_STYLE=true
# Add ADMIN_TOKEN, WORKER_TOKEN, CRON_TOKEN, CORS_ORIGIN, S3_ENDPOINT,
# S3_ACCESS_KEY, and S3_SECRET_KEY as protected NeoApp variables.
# Attach beanboard-db as DATABASE_URL and beanboard-orders as NATS_URL.

# Worker: beanboard-worker
API_URL=https://beanboard-api.example
NATS_STREAM=BEANBOARD_ORDERS
NATS_SUBJECT=beanboard.orders
NATS_CONSUMER=beanboard-baristas
NATS_MANAGE_RESOURCES=false
# Add WORKER_TOKEN as a protected variable and attach the queue as NATS_URL.

# Scheduled Job: beanboard-daily-summary
# Configure this in NEO's Scheduled Job form; it is not built from this repo.
# POST https://beanboard-api.example/api/cron/daily-summary
# Header: Authorization: Bearer <the CRON_TOKEN set on the Web Service>
# Header: Content-Type: application/json
# Body: {}

# Static Site: beanboard-web
BEANBOARD_API_URL=https://beanboard-api.example
